# Path secreto del editor (sin barra inicial). Debe ser editar-<token> de 12+ caracteres.
ADMIN_PATH=editar-cambia-este-token

# Hash PBKDF2 (no pongas la contraseña en claro). Generar:
#   node scripts/hash-admin-password.mjs "tu-password"
ADMIN_PASSWORD_HASH=pbkdf2$sha256$210000$salt$hash

# Secreto HMAC de la cookie de sesión (cadena larga aleatoria).
ADMIN_SESSION_SECRET=cambia-esta-clave-larga

# Token del Blob store privado (Vercel lo inyecta al vincular el store).
# Ahí vive admin/db.json: catálogo, pedidos, stock, clientes, pastelería y auditoría.
BLOB_READ_WRITE_TOKEN=
